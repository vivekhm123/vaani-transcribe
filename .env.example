# ── Supabase ────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Transcription provider ──────────────────────────────────
# Any OpenAI-compatible speech-to-text endpoint (Whisper / gpt-4o-transcribe).
# Get a key at https://platform.openai.com/api-keys
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Used for translation + romanization text generation (can be the same key/provider).
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── App behaviour ────────────────────────────────────────────
# Set to "true" only in local development when you have no API key yet.
# Production must NOT run with DEMO_MODE=true.
DEMO_MODE=false

# ── Limits (all values in seconds unless noted) ─────────────
FREE_MAX_DURATION_SECONDS=300
FREE_MONTHLY_LIMIT=3
PAID_MAX_DURATION_SECONDS=3600
PAID_MONTHLY_LIMIT=100
MAX_UPLOAD_BYTES=209715200
ANONYMOUS_MAX_DURATION_SECONDS=60
ANONYMOUS_MONTHLY_LIMIT=1
